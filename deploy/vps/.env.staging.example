# Shizzle STAGING configuration template. Copy to a NEW gitignored
# /opt/shizzle/staging/.env for the staging Compose project (shizzle-staging).
# Fill placeholders; never commit real secrets (invariant E3). Variables not
# listed here are documented in the repository root .env.example.

# Staging auth gate can use a different passcode/secret than production.
SHIZZLE_PASSCODE=changeme
TOKEN_SIGNING_SECRET=replace-with-a-long-random-secret
AUTH_VERSION=1
AUTH_TOKEN_TTL_SECONDS=604800

# Staging Compose database (separate volume from production).
POSTGRES_USER=shizzle
POSTGRES_PASSWORD=changeme
POSTGRES_DB=shizzle

# Cloud pipeline: RunPod separation is real on staging; the orchestrator
# heartbeat keeps /api/health green. See SHIZZLE_NODE_TOKENS below for nodes.
SHIZZLE_PIPELINE=cloud
SHIZZLE_EMBEDDED_ORCHESTRATOR=false
SHIZZLE_ALLOW_TEST_PIPELINE=false

# Admin page/API gate. Every /api/admin/* route answers 404 unless the
# request carries X-Shizzle-Admin with this exact value; staging Caddy injects
# it. Use a long random value (alphanumeric to be safe inside the Caddyfile);
# unset/empty keeps admin fail-closed.
SHIZZLE_ADMIN_PROXY_SECRET=

# AWS. Use staging's OWN media bucket — never the production bucket. The
# orchestrator names this bucket in every RunPod dispatch payload and reads
# manifests from it, so no application change is needed for isolation.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=
S3_MEDIA_BUCKET=shizzle-staging-media

# Staging media delivery: file-scoped signed CloudFront URLs (E5) against a
# distribution whose origin is the staging bucket above. Empty values leave
# CloudFront unconfigured: the staging site works but tracks cannot play
# (manifest media falls back to a /cdn path staging does not proxy).
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=/run/secrets/cloudfront_private_key.pem
MEDIA_COOKIE_PATH=/cdn
MEDIA_TTL_SECONDS=86400

# RunPod: same endpoint as production is fine — the dispatch payload names
# THIS stack's bucket, but the endpoint worker's IAM policy must allow
# read/write on the staging bucket too (docs/AUTOMATION.md, staging section).
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_POLL_SECONDS=10
RUNPOD_QUEUE_TIMEOUT_SECONDS=900
RUNPOD_WORKER_STALL_SECONDS=300
RUNPOD_COLD_START_SECONDS=1800

# Worker nodes. KEEP SHIZZLE_NODE_TOKENS EMPTY while production owns the
# Mac mini and Dell: with no tokens, no node can authenticate against staging
# (E6), so staging never claims their assignments. Consequences: URL jobs
# wait NODE_DOWNLOAD_WAIT_SECONDS and fail NO_NODE_AVAILABLE; uploads still
# separate on RunPod. To let staging run URL jobs, point a node agent at the
# staging origin with a token configured ONLY in this file (docs/WORKER-NODES.md).
SHIZZLE_NODE_ROUTING=prefer
SHIZZLE_NODE_TOKENS=
NODE_SEPARATE_WAIT_SECONDS=120
NODE_DOWNLOAD_WAIT_SECONDS=86400
NODE_ASSIGNMENT_MAX_SECONDS=10800

# Upload copy and successful duration-probe limits.
MAX_UPLOAD_BYTES=2147483648
MAX_DURATION_SECONDS=1800
PROCESSING_PROFILE_VERSION=1

# Managed by deploy-staging.sh on every deploy. Shape only:
# ghcr.io/mdc159/shizzle/api:sha-<40-hex>@sha256:<64-hex>
SHIZZLE_API_IMAGE=
