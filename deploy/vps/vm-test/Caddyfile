{
	auto_https off
}

# Self-signed TLS (Caddy internal CA) so Secure cookies behave as they do in
# production. Browsers/tests must accept the self-signed certificate.
:443 {
	tls /certs/cert.pem /certs/key.pem
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8001
	}
	# Same-origin media path. Production forwards /cdn to CloudFront; the twin
	# serves it from the in-VM MinIO bucket instead. handle_path strips the
	# prefix at match time (Caddy runs `rewrite` before `uri`, so `handle` +
	# `uri strip_prefix` forwards the wrong key).
	handle_path /cdn/* {
		rewrite * /karaoke-pimpshizzle{uri}
		reverse_proxy minio:9000
	}
	handle /ws/* {
		reverse_proxy api:8001
	}

	handle {
		root * /srv/ui
		try_files {path} /index.html
		file_server
	}
}

:80 {
	redir https://{host}{uri}
}
