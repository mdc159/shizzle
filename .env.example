# ─────────────────────────────────────────────────────────────────────────────
# Shizzle — environment template
# Copy to `.env` (compose) and fill in real values. `.env` is gitignored;
# NEVER commit real secrets. Windows system env vars are Mike's source of
# truth for personal keys — this file is for the app's own runtime config.
#
# Consumers: [api] FastAPI control plane · [orc] orchestrator · [worker] RunPod
#            [infra] provisioning/deploy scripts · [dev] local development only
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# [api] Shared passcode friends enter once per device. Rotating it (and bumping
# AUTH_VERSION) revokes every issued device token. Deliberately EMPTY here: a
# sample passcode that passes the gate is a known credential, and the API
# REFUSES TO START with this empty (invariant E6) unless
# SHIZZLE_ALLOW_OPEN_GATE=1 is set deliberately — the deploy preflight rejects
# an empty/missing value too. Set your own before deploying.
SHIZZLE_PASSCODE=
AUTH_VERSION=1
# [api] Public origin (the single CloudFront hostname once Phase 4 lands).
PUBLIC_ORIGIN=https://shizzle.example.com
# [api] Secret for signing device tokens + session codes (long random string).
TOKEN_SIGNING_SECRET=changeme-64-random-chars

# ── Database ─────────────────────────────────────────────────────────────────
# [api][orc] Postgres runs in compose; these feed both the container and the DSN.
POSTGRES_USER=shizzle
POSTGRES_PASSWORD=changeme
POSTGRES_DB=shizzle
DATABASE_URL=postgresql+asyncpg://shizzle:changeme@postgres:5432/shizzle

# ── AWS (real AWS — S3 + CloudFront) ─────────────────────────────────────────
# [api][orc][worker] Fresh IAM keys scoped to: the media bucket, CloudFront.
# NOTE machine-level gotcha: this PC has a global AWS_ENDPOINT_URL pointing at
# Cloudflare R2. We set it explicitly empty here so the real AWS SDK endpoints
# are used inside this project regardless of the host machine's globals.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=
# [api][worker] Private media bucket. Phase 4: the imported legacy library
# lives in `karaoke-pimpshizzle` under tracks/{id}/{gen}/ — the media-manifest
# route reads manifest.json from here.
S3_MEDIA_BUCKET=karaoke-pimpshizzle

# ── CloudFront signed cookies (design §3/§7) ─────────────────────────────────
# [api] The api issues CloudFront signed cookies (CloudFront-Policy/-Signature/
# -Key-Pair-Id) after the passcode gate. Caddy reverse-proxies the same-origin
# /cdn path to this distribution so the cookies ride along. Empty = CDN media
# delivery not wired (front end still viewable; media 403s).
CLOUDFRONT_DOMAIN=d2488k8kjndpsy.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=
# Path to the RSA private key file (mounted into the api container, not inline).
CLOUDFRONT_PRIVATE_KEY_PATH=/run/secrets/cloudfront_private_key.pem
# Same-origin path Caddy maps to the CDN, and the signed-cookie scope.
MEDIA_COOKIE_PATH=/cdn
MEDIA_TTL_SECONDS=86400

# ── RunPod ───────────────────────────────────────────────────────────────────
# [orc] Current machine-level RUNPOD_API_KEY is DEAD (verified 2026-08-02).
# Generate a fresh one in the RunPod dashboard.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# [orc] Webhook shared secret so only RunPod can hit our completion endpoint.
RUNPOD_WEBHOOK_SECRET=changeme

# ── Media pipeline knobs ─────────────────────────────────────────────────────
# [worker] AAC bitrate per stem — default decided by the Phase 0.4 blinded
# listening test. Candidates: 256k / 320k. ALAC is a separate rendition flag.
STEM_AAC_BITRATE=320k
# [worker] Mux the archival multi-track.mp4 per track (Mike's format — keep on).
CREATE_MULTITRACK_MP4=true
# [worker] Demucs model + common-gain policy version (thresholds from spike 0.3).
DEMUCS_MODEL=htdemucs_6s
PROCESSING_PROFILE_VERSION=1

# ── Ingest ───────────────────────────────────────────────────────────────────
# [api] Path to exported YouTube cookies file (mounted, not committed).
YTDLP_COOKIES_PATH=/run/secrets/youtube_cookies.txt
# [api] Upload guards (carried from k25 lineage).
MAX_UPLOAD_BYTES=2147483648
MAX_DURATION_SECONDS=1800

# ── YouTube Data API (Phase 7 search — metadata only, cannot download) ───────
# [api] Machine-level GOOGLE_API_KEY may already cover this; untested.
YOUTUBE_DATA_API_KEY=

# ── Dev-only ─────────────────────────────────────────────────────────────────
# [dev] Full-length personal golden track for local acceptance runs
# (CI uses the small bundled fixtures/golden-30s.mp4 instead).
GOLDEN_TRACK_PATH=

# ── Infra (deploy scripts only — NOT loaded by the app) ──────────────────────
# [infra] Hostinger token verified VALID 2026-08-02 (machine env var
# HOSTINGER_API_TOKEN) — used by provisioning scripts to create/manage the
# KVM 2. Referenced from the host environment, intentionally not duplicated here.
