# Shizzle configuration template. Copy to a NEW gitignored .env for Compose.
# Fill placeholders for the target environment; never commit real secrets.
# Native uv/uvicorn processes read process environment, not this file automatically.
# See docs/SETUP.md and deploy/runpod/README.md.

# API authentication. An EMPTY passcode disables auth; require a real production value.
SHIZZLE_PASSCODE=changeme
TOKEN_SIGNING_SECRET=replace-with-a-long-random-secret
AUTH_VERSION=1
AUTH_TOKEN_TTL_SECONDS=604800

# Compose database. Production Compose constructs DATABASE_URL from these values.
POSTGRES_USER=shizzle
POSTGRES_PASSWORD=changeme
POSTGRES_DB=shizzle
# Native processes need a reachable host in their DSN; "postgres" is a Compose service.
DATABASE_URL=postgresql+asyncpg://shizzle:changeme@postgres:5432/shizzle

# API and orchestrator share DATA_DIR. Compose supplies its container path.
SHIZZLE_PIPELINE=cloud
SHIZZLE_EMBEDDED_ORCHESTRATOR=false
SHIZZLE_ALLOW_TEST_PIPELINE=false

# AWS: use the media bucket's region. Empty endpoint means AWS, not another S3 service.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=
S3_MEDIA_BUCKET=karaoke-pimpshizzle

# Normal delivery uses file-scoped signed CloudFront URLs in the track manifest.
# Signed cookies support the same-origin /cdn fallback.
CLOUDFRONT_DOMAIN=d2488k8kjndpsy.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=/run/secrets/cloudfront_private_key.pem
MEDIA_COOKIE_PATH=/cdn
MEDIA_TTL_SECONDS=86400

# RunPod dispatch/polling; no inbound completion webhook is implemented.
# Both values are required for new cloud jobs. Verify live endpoint/image/pool separately.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_POLL_SECONDS=10
RUNPOD_QUEUE_TIMEOUT_SECONDS=900
RUNPOD_WORKER_STALL_SECONDS=300

# Upload copy and successful duration-probe limits.
MAX_UPLOAD_BYTES=2147483648
MAX_DURATION_SECONDS=1800
PROCESSING_PROFILE_VERSION=1

# Production Compose requires a digest-pinned API image supplied by the release workflow.
# Example shape only: ghcr.io/mdc159/shizzle/api@sha256:<64-hex-digest>
SHIZZLE_API_IMAGE=

# Optional personal source for local acceptance; CI uses fixtures/golden-30s.mp4.
GOLDEN_TRACK_PATH=
