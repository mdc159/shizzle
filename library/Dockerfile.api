# Control-plane image: API + orchestrator (no GPU, no Demucs).
# Used by the `stack` compose profile and, later, the VPS. The GPU reference
# pipeline keeps using ./Dockerfile (CUDA + Demucs) via the `local` profile.

FROM python:3.12-slim

# ffmpeg provides ffprobe for the upload duration gate (and ffmpeg for any
# light local media ops). Heavy media work belongs to the worker.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /usr/local/bin/uv

WORKDIR /app

COPY pyproject.toml uv.lock README.md alembic.ini ./
COPY alembic ./alembic
COPY src ./src
RUN uv sync --frozen --no-dev

ENV PATH="/app/.venv/bin:$PATH" \
    DATA_DIR=/app/data

EXPOSE 8001

# api service overrides with: alembic upgrade head && uvicorn ...
# orchestrator service overrides with: python -m shizzle_server.orchestrator
CMD ["uvicorn", "shizzle_server.main:app", "--host", "0.0.0.0", "--port", "8001"]
